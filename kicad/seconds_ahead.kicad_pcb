    (pad "2" thru_hole circle (at -11.43 -10.16) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 1 "GND"))
    (pad "10" thru_hole circle (at -11.43 2.54) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 3 "TRIG_A"))
    (pad "11" thru_hole circle (at -11.43 5.08) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4 "ECHO_A"))
    (pad "12" thru_hole circle (at -11.43 7.62) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 7 "IR_CONTACT"))
    (pad "14" thru_hole circle (at -11.43 12.7) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 5 "TRIG_B"))
    (pad "0" thru_hole circle (at 11.43 -12.7) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 8 "RED_ALERT"))
    (pad "13" thru_hole circle (at 11.43 -10.16) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 8 "RED_ALERT"))
    (pad "4" thru_hole circle (at 11.43 -7.62) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 9 "BLUE_MONITOR"))
    (pad "5" thru_hole circle (at 11.43 -5.08) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 10 "BUZZER_ACT"))
    (pad "22" thru_hole circle (at 11.43 7.62) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 11 "I2C_SDA"))
    (pad "23" thru_hole circle (at 11.43 10.16) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 12 "I2C_SCL"))
  )

  ;; Footprint U2: Front Ultrasonic Header
