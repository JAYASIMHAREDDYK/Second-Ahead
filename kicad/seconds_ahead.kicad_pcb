    (property "Value" "HC-SR04_FRONT" (at 0 3) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
    (pad "1" thru_hole rect (at -3.81 0 90) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 2 "+3V3"))
    (pad "2" thru_hole circle (at -1.27 0 90) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 3 "TRIG_A"))
    (pad "3" thru_hole circle (at 1.27 0 90) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 4 "ECHO_A"))
