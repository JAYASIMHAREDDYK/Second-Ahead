    (pad "2" thru_hole circle (at -1.27 0 90) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 5 "TRIG_B"))
    (pad "3" thru_hole circle (at 1.27 0 90) (size 1.6 1.6) (drill 1.0) (layers "*.Cu" "*.Mask") (net 6 "ECHO_B"))
