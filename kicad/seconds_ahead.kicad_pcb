(kicad_pcb (version 20240108) (generator pcbnew) (generator_version "8.0")

  (general
    (thickness 1.6)
    (legacy_teardrops no)
  )

  (paper "A4")
  (title_block
    (title "SECONDS AHEAD - Vehicle Approach Warning Prototype")
    (date "2026-10-14")
    (rev "2.0")
    (company "Team SECONDS AHEAD")
    (comment 1 "DeepPCB.ai KiCad 8.0 Native AI Routing")
  )

  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "User.Drawings")
    (41 "Cmts.User" user "User.Comments")
    (42 "Eco1.User" user "User.Eco1")
    (43 "Eco2.User" user "User.Eco2")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )

  (setup
    (pad_to_mask_clearance 0.05)
    (solder_mask_min_width 0.1)
    (pad_to_paste_clearance 0)
    (pad_to_paste_clearance_ratio 0)
    (aux_axis_origin 0 0)
    (grid_origin 0 0)
    (stackup
      (layer "F.SilkS" (type "Top Silk Screen"))
      (layer "F.Mask" (type "Top Solder Mask") (thickness 0.01))
      (layer "F.Cu" (type "copper") (thickness 0.035))
      (layer "dielectric 1" (type "core") (thickness 1.51) (material "FR4") (epsilon_r 4.5))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "None")
      (dielectric_constraints no)
    )
    (pcbplotparams
      (layerselection 0x00010fc_ffffffff)
      (plot_on_all_layers_selection 0x0000000_00000000)
      (disableapertmacros false)
      (usegerberextensions false)
      (usegerberattributes true)
      (usegerberadvancedattributes true)
      (creategerberjobfile true)
      (svgprecision 6)
      (excludeedgelayer true)
      (plotframeref false)
      (viasonmask false)
      (mode 1)
      (useauxorigin false)
      (hpglpennumber 1)
      (hpglpenspeed 20)
      (hpglpendiameter 15.000000)
      (pdf_front_fp_property_popups true)
      (pdf_back_fp_property_popups true)
      (dxfpadmode 0)
      (dxfellipsemode 1)
      (dxftEXTmode 0)
      (dxfarcprecision 16)
      (dxfwhichside 0)
      (outputformat 1)
      (mirror false)
      (drillshape 0)
      (scaleselection 1)
      (outputdirectory "")
    )
  )

  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "TRIG_A")
  (net 4 "ECHO_A")
  (net 5 "TRIG_B")
  (net 6 "ECHO_B")
  (net 7 "IR_CONTACT")
  (net 8 "RED_ALERT")
  (net 9 "BLUE_MONITOR")
  (net 10 "BUZZER_ACT")
  (net 11 "I2C_SDA")
  (net 12 "I2C_SCL")

  ;; Board Outline 85.0mm x 55.0mm (Edge.Cuts)
  (gr_line (start 100 80) (end 185 80) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 185 80) (end 185 135) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 185 135) (end 100 135) (layer "Edge.Cuts") (width 0.15))
  (gr_line (start 100 135) (end 100 80) (layer "Edge.Cuts") (width 0.15))

  ;; Silkscreen Labels
  (gr_text "SECONDS AHEAD v2.0" (at 142.5 83.5) (layer "F.SilkS")
    (effects (font (size 1.8 1.8) (thickness 0.25))))
  (gr_text "KiCad 8.0 / DeepPCB.ai Compatible" (at 142.5 87) (layer "F.SilkS")
    (effects (font (size 1.1 1.1) (thickness 0.15))))

  ;; Footprint U1: ESP32-H2 Dev Module Header Socket
